generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ToolStatus {
  DRAFT
  ACTIVE
  INACTIVE
  PAUSED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum MediaType {
  UPLOAD
  RESULT
  EXAMPLE
  BLOG_COVER
  PAGE_ASSET
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
  TEMP
}

enum MediaProcessingStatus {
  PENDING
  VALIDATED
  STORED
  OPTIMIZED
  FAILED
}

enum CreditTransactionType {
  PURCHASE
  USE
  REFUND
  ADMIN_ADJUSTMENT
  FREE_TRIAL
  REFERRAL_REWARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum ProviderBudgetMode {
  NOTIFY_ONLY
  PAUSE_PROVIDER
  PAUSE_TOOLS
  BLOCK_JOBS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FeatureFlagScope {
  GLOBAL
  TOOL
  PRICING
  LANGUAGE
  EXPERIMENT
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

enum ExperimentType {
  LANDING_PAGE
  PRICING
  UPLOAD_FLOW
  COPY
}

enum EmailEventType {
  PAYMENT_SUCCESSFUL
  CREDITS_ADDED
  JOB_COMPLETED
  JOB_FAILED_REFUNDED
  LOW_CREDITS
  WELCOME
  PASSWORD_RESET
  MFA_ENABLED
  TICKET_REPLY
  FAILED_PAYMENT
  REFERRAL_REWARD
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELLED
}

enum AffiliateStatus {
  ACTIVE
  DISABLED
  FROZEN
  SUSPICIOUS
}

enum AffiliateRewardStatus {
  PENDING
  APPROVED
  DELIVERED
  REVOKED
  CANCELLED
}

enum AffiliateRewardScope {
  FIRST_PAYMENT_ONLY
  ALL_PAYMENTS
}

enum ActorType {
  ADMIN
  USER
  SYSTEM
}

enum TicketCategory {
  BILLING
  CREDITS
  CLEAN_EXPORT
  FAILED_JOB
  AI_RESULT_QUALITY
  ACCOUNT_ACCESS
  BUG_REPORT
  OTHER
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum VerificationJobStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL_FAILED
  CANCELED
  CANCELLED
}

enum VerificationEmailStatus {
  VALID
  INVALID
  RISKY
  CATCH_ALL
  DISPOSABLE
  UNKNOWN
  DUPLICATE
}

enum ExpenseCategory {
  ADS
  SEO
  PROVIDER
  SOFTWARE
  DESIGN
  DOMAIN
  HOSTING
  OTHER
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  name             String?
  role             UserRole     @default(USER)
  creditBalance    Int          @default(0)
  freeTrialClaimed Boolean      @default(false)
  referredByUserId String?
  affiliateCode    String?      @unique
  status           RecordStatus @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  referredBy         User?               @relation("UserReferrals", fields: [referredByUserId], references: [id])
  referredUsers      User[]              @relation("UserReferrals")
  jobs               AiJob[]
  verificationJobs   VerificationJob[]
  mediaAssets        MediaAsset[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  subscriptions      Subscription[]
  adminLogs          AdminLog[]          @relation("AdminLogActor")
  emailEvents        EmailEvent[]
  referralsMade      Referral[]          @relation("ReferralReferrer")
  referralsReceived  Referral[]          @relation("ReferralReferred")
  tickets            Ticket[]
  ticketMessages     TicketMessage[]
  businessExpenses   BusinessExpense[] @relation("BusinessExpenseCreator")
  backupEvents       BackupEvent[]     @relation("BackupEventCreator")
  analyticsEvents    AnalyticsEvent[]
  affiliateProfile   AffiliateProfile?
  affiliateClicks    ReferralClick[]     @relation("ReferralClickMatchedUser")
  referralSignups    ReferralSignup[]    @relation("ReferralSignupReferred")
  affiliateRewards   ReferralReward[]    @relation("ReferralRewardAffiliate")
  referredRewards    ReferralReward[]    @relation("ReferralRewardReferred")
  payoutSnapshots    AffiliatePayoutSnapshot[]

  @@index([email])
  @@index([role, status])
  @@index([affiliateCode])
  @@index([referredByUserId])
}

model AffiliateProfile {
  id                      String          @id @default(cuid())
  userId                  String          @unique
  referralCode            String          @unique
  publicSlug              String?         @unique
  status                  AffiliateStatus @default(ACTIVE)
  tierKey                 String          @default("starter")
  customRewardPercent     Decimal?        @db.Decimal(5, 2)
  customMonthlyCapCredits Int?
  freezeRewards           Boolean         @default(false)
  trusted                 Boolean         @default(false)
  suspicious              Boolean         @default(false)
  fraudNotes              String?
  totalClicks             Int             @default(0)
  totalSignups            Int             @default(0)
  totalPaidReferrals      Int             @default(0)
  totalReferredRevenue    Decimal         @default(0) @db.Decimal(12, 2)
  totalRewardCredits      Int             @default(0)
  metadataJson            Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  user    User             @relation(fields: [userId], references: [id])
  clicks  ReferralClick[]
  signups ReferralSignup[]
  rewards ReferralReward[]

  @@index([status, tierKey])
  @@index([suspicious, trusted])
}

model ReferralClick {
  id                 String   @id @default(cuid())
  affiliateProfileId String?
  referralCode       String
  anonymousId        String?
  sessionId          String?
  ipHash             String?
  userAgentHash      String?
  landingPage        String?
  referrer           String?
  utmJson            Json?
  matchedUserId      String?
  createdAt          DateTime @default(now())

  affiliateProfile AffiliateProfile? @relation(fields: [affiliateProfileId], references: [id])
  matchedUser      User?             @relation("ReferralClickMatchedUser", fields: [matchedUserId], references: [id])

  @@index([referralCode, createdAt])
  @@index([affiliateProfileId, createdAt])
  @@index([anonymousId, createdAt])
  @@index([sessionId, createdAt])
  @@index([ipHash, createdAt])
}

model ReferralSignup {
  id                 String   @id @default(cuid())
  affiliateProfileId String
  referredUserId     String   @unique
  referralCode       String
  referralClickId    String?
  ipHash             String?
  userAgentHash      String?
  suspicious         Boolean  @default(false)
  fraudReason        String?
  createdAt          DateTime @default(now())

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id])
  referredUser     User             @relation("ReferralSignupReferred", fields: [referredUserId], references: [id])

  @@index([affiliateProfileId, createdAt])
  @@index([referralCode, createdAt])
  @@index([suspicious, createdAt])
}

model ReferralReward {
  id                     String                @id @default(cuid())
  affiliateProfileId     String
  affiliateUserId        String
  referredUserId         String
  paymentId              String
  status                 AffiliateRewardStatus @default(PENDING)
  paymentAmount          Decimal               @db.Decimal(10, 2)
  paymentCurrency        String                @default("usd")
  rewardPercentSnapshot  Decimal               @db.Decimal(5, 2)
  rewardUsdValueSnapshot Decimal               @db.Decimal(10, 2)
  creditUsdValueSnapshot Decimal               @db.Decimal(10, 4)
  rewardCredits          Int
  tierKeySnapshot        String
  tierNameSnapshot       String
  ruleSnapshotJson       Json?
  fraudFlagsJson         Json?
  deliveredTransactionId String?
  deliveredAt            DateTime?
  revokedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  affiliateProfile AffiliateProfile @relation(fields: [affiliateProfileId], references: [id])
  affiliateUser    User             @relation("ReferralRewardAffiliate", fields: [affiliateUserId], references: [id])
  referredUser     User             @relation("ReferralRewardReferred", fields: [referredUserId], references: [id])
  payment          Payment          @relation(fields: [paymentId], references: [id])

  @@unique([paymentId, affiliateUserId])
  @@index([affiliateProfileId, status, createdAt])
  @@index([affiliateUserId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([status, createdAt])
}

model AffiliatePayoutSnapshot {
  id               String   @id @default(cuid())
  affiliateUserId  String
  periodStart      DateTime
  periodEnd        DateTime
  status           String   @default("PREPARED")
  earnedCredits    Int      @default(0)
  deliveredCredits Int      @default(0)
  paymentRevenue   Decimal  @default(0) @db.Decimal(12, 2)
  metadataJson     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  affiliateUser User @relation(fields: [affiliateUserId], references: [id])

  @@index([affiliateUserId, periodStart, periodEnd])
  @@index([status, createdAt])
}

model AiTool {
  id                       String     @id @default(cuid())
  slug                     String
  version                  Int        @default(1)
  name                     String
  publicName               String?
  internalKey              String?
  qualityTier              String?
  category                 String
  description              String
  creditCost               Int
  status                   ToolStatus @default(DRAFT)
  inputRulesJson           Json
  outputType               String
  providerKey              String
  estimatedCostPerRun      Decimal?   @db.Decimal(10, 4)
  estimatedCostCurrency    String     @default("usd")
  estimatedCostProvider    String?
  providerConfigJson       Json
  seoTitle                 String
  seoDescription           String
  landingContentJson       Json
  exampleImagesJson        Json?
  fallbackProviderKeysJson Json?
  retryPolicyJson          Json?
  experimentKey            String?
  featured                 Boolean    @default(false)
  recommended              Boolean    @default(false)
  displayOrder             Int        @default(100)
  deletedAt                DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  jobs AiJob[]

  @@unique([slug, version])
  @@index([internalKey])
  @@index([qualityTier, providerKey])
  @@index([displayOrder])
  @@index([slug, status])
  @@index([providerKey])
}

model BusinessExpense {
  id              String          @id @default(cuid())
  title           String
  category        ExpenseCategory @default(OTHER)
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("usd")
  expenseDate     DateTime
  note            String?
  createdByUserId String?
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy User? @relation("BusinessExpenseCreator", fields: [createdByUserId], references: [id])

  @@index([expenseDate, category, deletedAt])
  @@index([category])
  @@index([createdByUserId])
}

model AiJob {
  id                   String    @id @default(cuid())
  userId               String?
  toolId               String
  providerKey          String
  providerRequestId    String?
  status               JobStatus @default(PENDING)
  inputImageId         String?
  outputImageId        String?
  creditCost           Int
  costEstimate         Decimal?  @db.Decimal(10, 4)
  estimatedCostAtRun   Decimal?  @db.Decimal(10, 4)
  estimatedCostCurrency String?
  estimatedCostProvider String?
  estimatedCostSource  String?
  estimatedRevenueAtRun Decimal? @db.Decimal(10, 4)
  estimatedProfitAtRun Decimal?  @db.Decimal(10, 4)
  toolNameSnapshot     String?
  toolInternalKeySnapshot String?
  qualityTierSnapshot  String?
  providerKeySnapshot  String?
  creditsChargedSnapshot Int?
  errorMessage         String?
  providerResponseJson Json?
  processingTimeMs     Int?
  retryCount           Int       @default(0)
  maxRetries           Int       @default(0)
  fallbackAttempted    Boolean   @default(false)
  fallbackProviderKey  String?
  toolVersion          Int
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  completedAt          DateTime?

  user               User?               @relation(fields: [userId], references: [id])
  tool               AiTool              @relation(fields: [toolId], references: [id])
  inputImage         MediaAsset?         @relation("InputImage", fields: [inputImageId], references: [id])
  outputImage        MediaAsset?         @relation("OutputImage", fields: [outputImageId], references: [id])
  creditTransactions CreditTransaction[]
  providerLogs       ProviderLog[]
  jobEvents          JobEvent[]
  tickets            Ticket[]

  @@index([userId, status])
  @@index([toolId, status])
  @@index([providerKey, status])
  @@index([createdAt])
  @@index([createdAt, status, toolId, providerKey])
  @@index([completedAt, estimatedCostSource])
  @@index([qualityTierSnapshot, providerKeySnapshot])
  @@index([completedAt, qualityTierSnapshot])
}

model Ticket {
  id            String         @id @default(cuid())
  userId        String
  aiJobId       String?
  verificationJobId String?
  category      TicketCategory
  status        TicketStatus   @default(OPEN)
  subject       String
  lastMessageAt DateTime       @default(now())
  closedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  aiJob    AiJob?          @relation(fields: [aiJobId], references: [id])
  verificationJob VerificationJob? @relation(fields: [verificationJobId], references: [id])
  messages TicketMessage[]

  @@index([userId, status, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([category, status])
  @@index([aiJobId])
  @@index([verificationJobId])
}

model TicketMessage {
  id        String    @id @default(cuid())
  ticketId  String
  userId    String?
  actorType ActorType
  body      String
  createdAt DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([ticketId, createdAt])
  @@index([userId, createdAt])
}

model MediaAsset {
  id                  String                @id @default(cuid())
  userId              String?
  type                MediaType
  storageKey          String
  originalFilename    String?
  checksum            String?
  mimeType            String
  fileSize            Int
  width               Int?
  height              Int?
  visibility          MediaVisibility       @default(PRIVATE)
  processingStatus    MediaProcessingStatus @default(PENDING)
  metadataJson        Json?
  expiresAt           DateTime?
  optimizedStorageKey String?
  cdnUrl              String?
  cacheControl        String?
  deletedAt           DateTime?
  createdAt           DateTime              @default(now())

  user          User?      @relation(fields: [userId], references: [id])
  inputForJobs  AiJob[]    @relation("InputImage")
  outputForJobs AiJob[]    @relation("OutputImage")
  blogPosts     BlogPost[]

  @@index([userId, type])
  @@index([visibility, expiresAt])
  @@index([checksum])
}

model CreditTransaction {
  id           String                @id @default(cuid())
  userId       String
  type         CreditTransactionType
  amount       Int
  balanceAfter Int
  aiJobId      String?
  verificationJobId String?
  paymentId    String?
  note         String?
  createdAt    DateTime              @default(now())

  user            User             @relation(fields: [userId], references: [id])
  aiJob           AiJob?           @relation(fields: [aiJobId], references: [id])
  verificationJob VerificationJob? @relation(fields: [verificationJobId], references: [id])
  payment         Payment?         @relation(fields: [paymentId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
  @@index([createdAt, type])
  @@index([verificationJobId])
  @@index([paymentId])
}

model VerificationJob {
  id                         String                @id @default(cuid())
  userId                     String
  status                     VerificationJobStatus @default(QUEUED)
  sourceType                 String                @default("upload")
  originalFilename           String?
  inputStorageKey            String?
  fullReportStorageKey       String?
  validExportStorageKey      String?
  invalidExportStorageKey    String?
  riskyExportStorageKey      String?
  providerKey                String                @default("millionverifier")
  providerRequestId          String?
  providerBatchCount         Int                   @default(0)
  totalEmails                Int                   @default(0)
  uniqueEmails               Int                   @default(0)
  duplicateCount             Int                   @default(0)
  validCount                 Int                   @default(0)
  invalidCount               Int                   @default(0)
  riskyCount                 Int                   @default(0)
  catchAllCount              Int                   @default(0)
  disposableCount            Int                   @default(0)
  unknownCount               Int                   @default(0)
  creditsReserved            Int                   @default(0)
  creditsUsed                Int                   @default(0)
  creditValueAtRun           Decimal?              @db.Decimal(10, 4)
  costPerVerificationAtRun   Decimal?              @db.Decimal(10, 6)
  providerCostAtRun          Decimal?              @db.Decimal(10, 4)
  providerCostCurrency       String?               @default("usd")
  estimatedRevenueAtRun      Decimal?              @db.Decimal(10, 4)
  estimatedProfitAtRun       Decimal?              @db.Decimal(10, 4)
  errorMessage               String?
  progressPercent            Int                   @default(0)
  metadataJson               Json?
  deletedAt                  DateTime?
  startedAt                  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  user               User                      @relation(fields: [userId], references: [id])
  results            VerificationEmailResult[]
  creditTransactions CreditTransaction[]
  tickets            Ticket[]

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerKey, status, createdAt])
  @@index([completedAt])
  @@index([createdAt, status])
}

model VerificationEmailResult {
  id                String                  @id @default(cuid())
  verificationJobId String
  email             String
  normalizedEmail   String
  status            VerificationEmailStatus
  reason            String?
  domain            String?
  mxFound           Boolean?
  disposable        Boolean?
  roleBased         Boolean?
  freeProvider      Boolean?
  rawJson           Json?
  createdAt         DateTime                @default(now())

  verificationJob VerificationJob @relation(fields: [verificationJobId], references: [id], onDelete: Cascade)

  @@index([verificationJobId, status])
  @@index([verificationJobId, createdAt])
  @@index([verificationJobId, status, createdAt])
  @@index([normalizedEmail])
  @@index([domain])
}

model CreditPackage {
  id             String       @id @default(cuid())
  name           String
  credits        Int
  bonusCredits   Int          @default(0)
  price          Decimal      @db.Decimal(10, 2)
  currency       String       @default("usd")
  stripePriceId  String?
  status         RecordStatus @default(ACTIVE)
  sortOrder      Int          @default(0)
  description    String?
  audience       String?
  badgeText      String?
  highlight      Boolean      @default(false)
  featureFlagKey String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, sortOrder])
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String        @default("usd")
  creditsDelivered        Int           @default(0)
  status                  PaymentStatus @default(PENDING)
  couponCode              String?
  rawEventJson            Json?
  deletedAt               DateTime?
  createdAt               DateTime      @default(now())

  user               User                @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]
  referralRewards    ReferralReward[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, createdAt])
  @@index([stripePaymentIntentId])
}

model Subscription {
  id                   String       @id @default(cuid())
  userId               String
  stripeSubscriptionId String?      @unique
  planId               String
  status               RecordStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model ProviderSetting {
  id                        String             @id @default(cuid())
  providerKey               String             @unique
  name                      String
  providerType              String             @default("other")
  status                    RecordStatus       @default(INACTIVE)
  apiKeyEncrypted           String?
  envKeyName                String?
  configJson                Json               @default("{}")
  dailyBudgetLimit          Decimal?           @db.Decimal(10, 2)
  monthlyBudgetLimit        Decimal?           @db.Decimal(10, 2)
  monthlyBudgetUsed         Decimal            @default(0) @db.Decimal(10, 2)
  estimatedCostPerRun       Decimal?           @db.Decimal(10, 4)
  estimatedCostCurrency     String             @default("usd")
  budgetEnforcementMode     ProviderBudgetMode @default(NOTIFY_ONLY)
  priority                  Int                @default(100)
  notes                     String?
  safeAdminEditableKeysJson Json?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([providerKey, status])
  @@index([status, priority])
}

model ProviderLog {
  id            String   @id @default(cuid())
  aiJobId       String?
  providerKey   String
  requestJson   Json?
  responseJson  Json?
  statusCode    Int?
  errorMessage  String?
  attemptNumber Int      @default(1)
  timedOut      Boolean  @default(false)
  createdAt     DateTime @default(now())

  aiJob AiJob? @relation(fields: [aiJobId], references: [id])

  @@index([aiJobId])
  @@index([providerKey, createdAt])
}

model JobEvent {
  id           String   @id @default(cuid())
  aiJobId      String
  type         String
  message      String
  metadataJson Json?
  createdAt    DateTime @default(now())

  aiJob AiJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@index([aiJobId, createdAt])
  @@index([type])
}

model AdminLog {
  id           String   @id @default(cuid())
  adminUserId  String?
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  adminUser User? @relation("AdminLogActor", fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

model BlogPost {
  id              String        @id @default(cuid())
  title           String
  slug            String
  metaTitle       String
  metaDescription String
  coverImageId    String?
  contentJson     Json
  language        String        @default("en")
  status          ContentStatus @default(DRAFT)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  publishedAt     DateTime?

  coverImage MediaAsset? @relation(fields: [coverImageId], references: [id])

  @@unique([slug, language])
  @@index([status, language])
}

model Page {
  id              String        @id @default(cuid())
  slug            String
  title           String
  metaTitle       String
  metaDescription String
  contentJson     Json
  language        String        @default("en")
  status          ContentStatus @default(DRAFT)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([slug, language])
  @@index([status, language])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueJson Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  scope       FeatureFlagScope @default(GLOBAL)
  enabled     Boolean          @default(false)
  rulesJson   Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Experiment {
  id                    String           @id @default(cuid())
  key                   String           @unique
  name                  String
  type                  ExperimentType
  status                ExperimentStatus @default(DRAFT)
  variantsJson          Json
  trafficAllocationJson Json
  startAt               DateTime?
  endAt                 DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model TrackingSetting {
  id         String   @id @default(cuid())
  provider   String   @unique
  enabled    Boolean  @default(false)
  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WebhookLog {
  id           String   @id @default(cuid())
  source       String
  externalEventId String?
  eventType    String
  payloadJson  Json
  status       String
  errorMessage String?
  paymentId    String?
  userId       String?
  processedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([source, eventType])
  @@index([status, createdAt])
  @@unique([source, externalEventId])
}

model EmailEvent {
  id                String         @id @default(cuid())
  userId            String?
  eventType         EmailEventType
  status            DeliveryStatus @default(PENDING)
  templateKey       String
  recipientEmail    String?
  provider          String?
  idempotencyKey    String?        @unique
  payloadJson       Json?
  providerMessageId String?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sentAt            DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([eventType, status])
  @@index([recipientEmail, createdAt])
}

model BackupEvent {
  id              String   @id @default(cuid())
  type            String
  status          String   @default("PENDING")
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  fileSize        Int?
  storageLocation String?
  restoreTested   Boolean  @default(false)
  errorMessage    String?
  metadataJson    Json?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User? @relation("BackupEventCreator", fields: [createdByUserId], references: [id])

  @@index([type, status, startedAt])
  @@index([createdByUserId, startedAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  anonymousId String?
  event       String
  source      String   @default("server")
  page        String?
  referrer    String?
  country     String?
  device      String?
  browser     String?
  metadataJson Json?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([anonymousId, createdAt])
  @@index([source, createdAt])
  @@index([country, createdAt])
  @@index([device, createdAt])
}

model Referral {
  id             String         @id @default(cuid())
  referrerUserId String
  referredUserId String?
  referralCode   String
  status         ReferralStatus @default(PENDING)
  rewardCredits  Int            @default(0)
  createdAt      DateTime       @default(now())
  qualifiedAt    DateTime?

  referrer User  @relation("ReferralReferrer", fields: [referrerUserId], references: [id])
  referred User? @relation("ReferralReferred", fields: [referredUserId], references: [id])

  @@index([referrerUserId, status])
  @@index([referralCode])
}

model NewsletterSubscriber {
  id           String       @id @default(cuid())
  email        String       @unique
  language     String       @default("en")
  country      String?
  source       String?
  status       RecordStatus @default(ACTIVE)
  metadataJson Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AuditEvent {
  id          String    @id @default(cuid())
  actorUserId String?
  actorType   ActorType @default(SYSTEM)
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model RateLimit {
  id          String   @id @default(cuid())
  userId      String?
  ipAddress   String?
  action      String
  count       Int      @default(0)
  windowStart DateTime
  createdAt   DateTime @default(now())

  @@index([userId, action, windowStart])
  @@index([ipAddress, action, windowStart])
}
